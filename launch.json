{
    "version": "0.2.0",
    "configurations": [
        {
            "type": "chrome",
            "request": "launch",
            "name": "Abrir site no Chrome",
            "url": "http://localhost:3000",
            "webRoot": "${workspaceFolder}"
        },
        {
            "type": "node",
            "request": "launch",
            "name": "Iniciar API",
            "program": "${workspaceFolder}/servidor.js",
            "console": "integratedTerminal"
        }
    ]
}
